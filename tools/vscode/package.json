{
  "name": "aquila-language",
  "displayName": "Aquila Language",
  "description": "Language support for the Aquila programming language",
  "version": "0.1.0",
  "publisher": "mplsllc",
  "engines": {"vscode": "^1.80.0"},
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "aquila",
      "aliases": ["Aquila", "aquila"],
      "extensions": [".aquila"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "aquila",
      "scopeName": "source.aquila",
      "path": "./syntaxes/aquila.tmLanguage.json"
    }]
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:aquila"]
}
